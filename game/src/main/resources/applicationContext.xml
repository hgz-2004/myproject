<?xml version="1.0" encoding="UTF-8"?>
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.2.xsd">

    <!--  使用构造器实例化  -->
    <bean id="baiqi" class="game.hero.Baiqi"></bean>

    <!--  步骤 4：增加 Zhangfei 的配置  -->
    <bean id="zhangfei" class="game.hero.Zhangfei"></bean>

    <!--  任务2.3 步骤2：使用构造方法注入实例 hanxin  -->
    <bean id="hanxin" class="game.hero.CustomHero">
        <constructor-arg name="name" value="韩信"/>
        <constructor-arg name="slogan" value="必将百倍奉还"/>
    </bean>

    <!--  任务2.3 步骤2：使用Setter方法注入实例 caocao  -->
    <bean id="caocao" class="game.hero.CustomHero">
        <property name="name" value="曹操"/>
        <property name="slogan" value="周公吐哺，天下归心"/>
    </bean>

</beans>
